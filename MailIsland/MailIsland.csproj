<Project Sdk="Microsoft.NET.Sdk">

  <!-- ClassIsland 插件使用 Avalonia，不启用 WPF；UseWindowsForms 保持与 SDK 依赖一致 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 允许在 Linux/macOS 上交叉编译 Windows 目标（构建校验用） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RootNamespace>MailIsland</RootNamespace>
    <!-- 宿主 ClassIsland.PluginSdk (2.1.1.1) 在 Build 后通过 CreateCipx 自动打包为 CIPX -->
    <CreateCipx>true</CreateCipx>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MailIsland.Logic/MailIsland.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1.1">
      <!-- 宿主已提供 ClassIsland.Core / PluginSdk 及运行时依赖，不随插件复制，
           避免插件目录携带宿主自身 DLL 导致加载冲突（表现为“已安装，未加载”）。 -->
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0">
      <!-- 宿主亦使用 CommunityToolkit.Mvvm，运行时复用宿主程序集，不随插件复制，避免类型出现两个实例。 -->
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="version.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>