<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:conv="clr-namespace:MailIsland.Converters"
             x:Class="MailIsland.SettingsPage.Views.NotifyTabPage">

    <UserControl.Resources>
        <conv:EnumIndexConverter x:Key="EnumIndexConverter" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Classes="settings-container" Spacing="12">
            <controls:SettingsExpander Header="新邮件提醒"
                                       Description="通过 ClassIsland 提醒服务推送新邮件提醒">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="启用提醒" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding NotifyEnabled, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="正文层显示" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding OverlayContentKindNames}"
                                  SelectedIndex="{Binding OverlayContentKind, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                  MinWidth="140" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="同步设置"
                                       Description="收件轮询参数">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="轮询间隔（分钟）" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Minimum="1" Maximum="1440" Value="{Binding PollIntervalMinutes, Mode=TwoWay}" Width="120" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="拉取数量" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Minimum="1" Maximum="200" Value="{Binding MailCountLimit, Mode=TwoWay}" Width="100" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="关键词提醒"
                                       Description="新邮件在发件人/主题/正文命中关键词时提醒；未配置则默认全量提醒">
                <controls:SettingsExpander.Footer>
                    <Button x:Name="AddKeywordButton" Content="添加关键词" Classes="accent" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <ItemsControl x:Name="KeywordList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="12,8"
                                CornerRadius="6"
                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <Grid ColumnDefinitions="*,12,Auto,12,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Keyword, Mode=TwoWay}"
                                         Watermark="关键词" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding DataContext.MatchScopes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedIndex="{Binding Scope, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                          MinWidth="110" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                    <Button Content="删除" Click="OnRemoveKeywordClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>