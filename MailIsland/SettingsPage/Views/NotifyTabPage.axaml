<ci:SettingsPageBase x:Class="MailIsland.SettingsPage.Views.NotifyTabPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:conv="clr-namespace:MailIsland.Converters">

    <ci:SettingsPageBase.Resources>
        <conv:EnumIndexConverter x:Key="EnumIndexConverter" />
    </ci:SettingsPageBase.Resources>

    <ScrollViewer>
        <StackPanel Classes="settings-container" Spacing="12">
            <controls:FASettingsExpander Header="新邮件提醒"
                                       Description="通过 ClassIsland 提醒服务推送新邮件提醒">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="启用提醒" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding NotifyEnabled, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="遮罩标题" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding MaskContentKindNames}"
                                  SelectedIndex="{Binding MaskContentKind, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                  MinWidth="140" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="正文层显示" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding OverlayContentKindNames}"
                                  SelectedIndex="{Binding OverlayContentKind, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                  MinWidth="140" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="显示方式" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding DisplayModeNames}"
                                  SelectedIndex="{Binding DisplayMode, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                  MinWidth="160" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="语音朗读" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding NotificationSpeechEnabled, Mode=TwoWay}" />
                        <TextBlock Text="（默认关闭，避免朗读邮件内容）" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="合并提醒" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding NotifySummaryMode, Mode=TwoWay}" />
                        <TextBlock Text="（同一轮多封新邮件只弹一条）" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander Header="免打扰"
                                       Description="在指定时段内不弹出提醒，自动化仍会正常触发">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="启用免打扰" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding QuietHoursEnabled, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="开始" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Width="80" Text="{Binding QuietHoursStart, Mode=TwoWay}" Watermark="21:00" />
                        <TextBlock Text="结束" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Width="80" Text="{Binding QuietHoursEnd, Mode=TwoWay}" Watermark="07:00" />
                        <TextBlock Text="格式：HH:mm，支持跨午夜" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander Header="显示参数"
                                       Description="静态显示时长与滚动速度">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="静态时长（秒）" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Minimum="3" Maximum="120" Value="{Binding StaticDisplaySeconds, Mode=TwoWay}" Width="110" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="滚动速度（字/秒）" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Minimum="1" Maximum="100" Value="{Binding ScrollCharsPerSecond, Mode=TwoWay}" Width="110" />
                    </StackPanel>
                </StackPanel>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander Header="同步设置"
                                       Description="收件轮询参数">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="轮询间隔（分钟）" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Minimum="1" Maximum="1440" Value="{Binding PollIntervalMinutes, Mode=TwoWay}" Width="120" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="拉取数量" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Minimum="1" Maximum="200" Value="{Binding MailCountLimit, Mode=TwoWay}" Width="100" />
                    </StackPanel>
                </StackPanel>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander Header="关键词提醒"
                                       Description="新邮件在发件人/主题/正文命中关键词时提醒；未配置则默认全量提醒">
                <controls:FASettingsExpander.Footer>
                    <Button x:Name="AddKeywordButton" Content="添加关键词" Classes="accent" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <ItemsControl x:Name="KeywordList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="12,8"
                                CornerRadius="6"
                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <Grid ColumnDefinitions="*,12,Auto,12,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Keyword, Mode=TwoWay}"
                                         Watermark="关键词" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding DataContext.MatchScopes, RelativeSource={RelativeSource AncestorType=ci:SettingsPageBase}}"
                                          SelectedIndex="{Binding Scope, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}"
                                          MinWidth="110" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                    <Button Content="删除" Click="OnRemoveKeywordClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>