<ci:SettingsPageBase x:Class="MailIsland.SettingsPage.Views.MailTabPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:conv="clr-namespace:MailIsland.Converters">

    <ci:SettingsPageBase.Resources>
        <conv:UnreadBoldConverter x:Key="UnreadBoldConverter" />
    </ci:SettingsPageBase.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部：账号、搜索、图片开关、刷新（仅在列表视图显示） -->
        <Grid x:Name="HeaderBar"
              Grid.Row="0"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
              Margin="0,0,0,8">
            <TextBlock Grid.Column="0"
                       Text="收件账号"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox Grid.Column="1"
                      x:Name="AccountCombo"
                      MinWidth="220"
                      VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding DisplayName}" />
                            <TextBlock Text="{Binding Email}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Column="2"
                     x:Name="SearchBox"
                     Width="180"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Watermark="搜索发件人、主题或正文"
                     Text="{Binding SearchText, Mode=TwoWay}" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="加载正文图片"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch IsChecked="{Binding LoadBodyImages, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="远程图片可能包含跟踪像素，默认关闭" />
            </StackPanel>

            <Button Grid.Column="5"
                    x:Name="ComposeButton"
                    Content="写邮件"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Click="OnComposeClick"
                    ToolTip.Tip="写一封新邮件" />

            <Button Grid.Column="6"
                    x:Name="RefreshButton"
                    Content="刷新邮件"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding !IsLoading}"
                    ToolTip.Tip="重新从服务器收取最近邮件" />
        </Grid>

        <!-- 邮件列表（整页） -->
        <Border x:Name="ListView"
                Grid.Row="1"
                CornerRadius="8"
                Padding="8"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Top"
                           Text="{Binding Status}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Ellipse Grid.Column="0"
                                                 Width="8"
                                                 Height="8"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="#D13438"
                                                 IsVisible="{Binding IsUnread}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SubjectDisplay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontWeight="{Binding IsUnread, Converter={StaticResource UnreadBoldConverter}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SenderDisplay}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DateDisplay}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="含附件"
                                               IsVisible="{Binding HasAttachment}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 邮件详情（整页，左上角返回） -->
        <Grid x:Name="DetailView"
              Grid.Row="1"
              RowDefinitions="Auto,*"
              IsVisible="False">
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8">
                <Button x:Name="BackButton"
                        Content="返回"
                        Click="OnBackClick"
                        ToolTip.Tip="返回邮件列表" />
                <Button x:Name="ReplyButton"
                        Content="回复"
                        Click="OnReplyClick"
                        ToolTip.Tip="回复这封邮件" />
                <Button x:Name="ForwardButton"
                        Content="转发"
                        Click="OnForwardClick"
                        ToolTip.Tip="转发这封邮件" />
            </StackPanel>
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DetailHint"
                                   Text="点击一封邮件查看正文和附件。"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="DetailContent" Spacing="8" IsVisible="False">
                            <TextBlock x:Name="DetailSubject"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailFrom"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailDate"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ContentControl x:Name="BodyHost" />

                            <TextBlock x:Name="AttachmentHeader"
                                       Text="附件"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsVisible="False" />
                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding FileName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SizeDisplay}"
                                                           Margin="8,0"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Button Grid.Column="2"
                                                        Content="保存到桌面"
                                                        Click="OnDownloadAttachmentClick"
                                                        ToolTip.Tip="下载并保存到桌面" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="打开所在文件夹"
                                    IsVisible="{Binding HasSavedAttachment}"
                                    HorizontalAlignment="Left"
                                    Click="OnOpenFolderClick"
                                    ToolTip.Tip="在资源管理器中定位最近保存的附件" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 写邮件（整页） -->
        <Grid x:Name="ComposeView"
              Grid.Row="1"
              RowDefinitions="Auto,*"
              IsVisible="False">
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,8">
                <Button x:Name="ComposeBackButton"
                        Content="返回"
                        Click="OnComposeBackClick"
                        ToolTip.Tip="返回邮件列表" />
                <TextBlock Text="写邮件"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="1"
                    CornerRadius="8"
                    Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="收件人"
                                       Width="56"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding To, Mode=TwoWay}"
                                     Watermark="多个地址用逗号或分号分隔" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="抄送"
                                       Width="56"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Cc, Mode=TwoWay}"
                                     Watermark="可留空" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="密送"
                                       Width="56"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Bcc, Mode=TwoWay}"
                                     Watermark="可留空" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="主题"
                                       Width="56"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Subject, Mode=TwoWay}"
                                     Watermark="邮件主题" />
                        </Grid>

                        <TextBox Text="{Binding Body, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Watermark="正文" />

                        <Grid ColumnDefinitions="Auto,*">
                            <Button Content="添加附件"
                                    Click="OnAddAttachmentClick"
                                    ToolTip.Tip="从本地选择文件" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AttachmentSummary}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2"
                                            Padding="10,6"
                                            CornerRadius="6"
                                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeDisplay}"
                                                       Margin="8,0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Button Grid.Column="2"
                                                    Content="移除"
                                                    Click="OnRemoveComposeAttachmentClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Content="保存到“已发送”"
                                  IsChecked="{Binding SaveSentCopy, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="发送"
                                    Classes="accent"
                                    Click="OnSendClick"
                                    IsEnabled="{Binding !IsSending}" />
                            <Button Content="取消"
                                    Click="OnComposeBackClick" />
                        </StackPanel>

                        <TextBlock Text="{Binding Status}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 放弃确认浮层 -->
            <Border x:Name="DiscardOverlay"
                    Grid.RowSpan="2"
                    IsVisible="False"
                    Background="#66000000">
                <Border Padding="20"
                        CornerRadius="8"
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="放弃这封邮件？"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="已填写的内容不会保存。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button Content="继续编辑" Click="OnDiscardCancelClick" />
                            <Button Content="放弃" Classes="accent" Click="OnDiscardConfirmClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</ci:SettingsPageBase>
