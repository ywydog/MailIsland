<ci:SettingsPageBase x:Class="MailIsland.SettingsPage.Views.MailTabPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:conv="clr-namespace:MailIsland.Converters">

    <ci:SettingsPageBase.Resources>
        <conv:UnreadBoldConverter x:Key="UnreadBoldConverter" />
    </ci:SettingsPageBase.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="收件账号" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="AccountCombo" MinWidth="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Email}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         Width="200"
                         VerticalAlignment="Center"
                         Watermark="搜索发件人、主题或正文"
                         Text="{Binding SearchText, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="加载正文图片" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch IsChecked="{Binding LoadBodyImages, Mode=TwoWay}"
                                  ToolTip.Tip="远程图片可能包含跟踪像素，默认关闭" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Content="刷新邮件"
                    IsEnabled="{Binding !IsLoading}"
                    ToolTip.Tip="重新从服务器收取最近邮件" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="3*,*">
            <!-- 邮件列表 -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    Padding="8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <DockPanel>
                    <TextBlock x:Name="StatusText"
                               DockPanel.Dock="Top"
                               Text="{Binding Status}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                    <TextBlock Grid.Column="0"
                                               Text="●"
                                               IsVisible="{Binding IsUnread}"
                                               VerticalAlignment="Top"
                                               Margin="0,2,6,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemAccentColor}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding SubjectDisplay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontWeight="{Binding IsUnread, Converter={StaticResource UnreadBoldConverter}}" />
                                        <TextBlock Text="{Binding SenderDisplay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Spacing="2"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DateDisplay}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="含附件"
                                                   IsVisible="{Binding HasAttachment}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 邮件详情 -->
            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    CornerRadius="8"
                    Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DetailHint"
                                   Text="从左侧选择一封邮件，这里会显示正文和附件。"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="DetailContent" Spacing="8" IsVisible="False">
                            <TextBlock x:Name="DetailSubject"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailFrom"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailDate"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ContentControl x:Name="BodyHost" />

                            <TextBlock x:Name="AttachmentHeader"
                                       Text="附件"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsVisible="False" />
                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding FileName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SizeDisplay}"
                                                           Margin="8,0"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Button Grid.Column="2"
                                                        Content="保存到桌面"
                                                        Click="OnDownloadAttachmentClick"
                                                        ToolTip.Tip="下载并保存到桌面" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="打开所在文件夹"
                                    IsVisible="{Binding HasSavedAttachment}"
                                    HorizontalAlignment="Left"
                                    Click="OnOpenFolderClick"
                                    ToolTip.Tip="在资源管理器中定位最近保存的附件" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ci:SettingsPageBase>
